# --- Contact form (real delivery) ---
# Messages go to this inbox via FormSubmit.co (default: profile.email in data.ts).
# First submission: open the confirmation email FormSubmit sends, then retry.
# VITE_FORMSUBMIT_EMAIL=Valechch05@gmail.com

# Optional: use Formspree instead of FormSubmit
# Create a form at https://formspree.io → paste endpoint:
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# --- Google Meet via Calendly ---
# 1) Create a free Calendly account linked to Google Calendar
# 2) Event type 15 min → Location: Google Meet
# 3) Paste the event URL:
# VITE_CALENDLY_URL=https://calendly.com/your-username/15min

# Legacy AI Studio (unused by portfolio contact)
# GEMINI_API_KEY=
# APP_URL=
